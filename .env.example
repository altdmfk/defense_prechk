# Target deployed URL to test against (Required)
TARGET_URL=https://your-deployed-site.com

# 사용자 JWT 토큰 (선택 사항이지만 권장)
# [용도 설명] BOLA(IDOR) 취약점 테스트 (예: 타인의 게시물을 무단으로 읽거나 삭제하려는 시도)를 수행할 때 필요합니다.
# 방어 테스트 스크립트가 '로그인된 사용자'로 위장하여 다른 사람의 데이터에 접근 가능한지 확인해야 하므로,
# 실제 브라우저 등에서 로그인한 뒤 발급받은 유효한 토큰 값을 여기에 넣어주세요.
# (토큰이 없으면 401 에러로 인해 권한 테스트 자체가 진행되지 않을 수 있습니다.)
# USER_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Base path for notes API (Default: /api/notes)
# API_BASE=/api/notes
