# 테스트할 대상 서버 주소 (기본값: http://localhost:4000)
TARGET_URL=http://localhost:4000

# 일반 사용자(학생 등) JWT 토큰 (선택 사항)
# BOLA/IDOR 취약점 테스트나 일반 권한 우회 테스트 시 사용됩니다.
USER_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_user_token

# 관리자(강사 등) JWT 토큰 (선택 사항)
# RBAC(권한 분리) 경계 테스트 시 일반 사용자와 비교하기 위해 사용됩니다.
ADMIN_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_admin_token
